{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eventheoddsfoundry.com/schemas/vera-sb253-attestation-receipt/v1.0.0",
  "title": "VERA Substrata SB 253 / CARB Attestation Receipt",
  "description": "Deterministic, cryptographically attested emissions disclosure receipt conforming to California SB 253 (Health & Safety Code § 38532), CARB Initial Regulation (Title 17 CCR §§ 96070–96077), GHG Protocol Corporate Standard, and Scope 2 Guidance. Supports first-year (2026) filings, first-year relief statements, and forward-compatible Scope 3 + assurance phase-in. Quantum-ready signature paths included.",
  "type": "object",
  "required": [
    "schemaVersion",
    "receiptId",
    "generatedAt",
    "entity",
    "reportingPeriod",
    "organizationalBoundary",
    "scope1",
    "scope2",
    "methodology",
    "assurance",
    "firstYearRelief",
    "provenance",
    "enforcementAwareness"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0",
      "description": "Version of this receipt schema."
    },
    "receiptId": {
      "type": "string",
      "format": "uuid",
      "description": "Globally unique identifier for this attestation receipt."
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp when this receipt was generated by the VERA engine."
    },
    "engineVersion": {
      "type": "string",
      "description": "Semantic version of the deterministic VERA compute core that produced this receipt."
    },
    "entity": {
      "type": "object",
      "description": "Reporting entity identity and coverage tests under SB 253 / 17 CCR § 96072.",
      "required": [
        "legalName",
        "entityType",
        "stateOfFormation",
        "ein",
        "revenuePriorFiscalYear1",
        "revenuePriorFiscalYear2",
        "lesserOfTwoYearsRevenue",
        "exceedsOneBillionThreshold",
        "californiaNexus",
        "exemptionsEvaluated"
      ],
      "additionalProperties": false,
      "properties": {
        "legalName": { "type": "string", "minLength": 1 },
        "entityType": {
          "type": "string",
          "enum": ["corporation", "llc", "partnership", "limited_partnership", "other"]
        },
        "stateOfFormation": { "type": "string", "minLength": 2 },
        "ein": {
          "type": "string",
          "pattern": "^[0-9]{2}-[0-9]{7}$|^[0-9]{9}$"
        },
        "website": { "type": ["string", "null"], "format": "uri" },
        "revenuePriorFiscalYear1": { "type": "number", "minimum": 0 },
        "revenuePriorFiscalYear2": { "type": "number", "minimum": 0 },
        "lesserOfTwoYearsRevenue": { "type": "number", "minimum": 0 },
        "exceedsOneBillionThreshold": { "type": "boolean" },
        "californiaNexus": {
          "type": "object",
          "required": ["organizedInCalifornia", "californiaSalesAboveThreshold", "doesBusinessInCalifornia"],
          "additionalProperties": false,
          "properties": {
            "organizedInCalifornia": { "type": "boolean" },
            "californiaSalesAboveThreshold": { "type": "boolean" },
            "doesBusinessInCalifornia": { "type": "boolean" },
            "nexusNotes": { "type": ["string", "null"] }
          }
        },
        "exemptionsEvaluated": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["category", "applies"],
            "additionalProperties": false,
            "properties": {
              "category": {
                "type": "string",
                "enum": [
                  "tax_exempt_nonprofit",
                  "insurance_entity_regulated_by_cdi",
                  "government_owned_majority",
                  "wholesale_electricity_only",
                  "payroll_only_including_teleworkers",
                  "other"
                ]
              },
              "applies": { "type": "boolean" },
              "rationale": { "type": ["string", "null"] }
            }
          }
        },
        "naicsCode": { "type": ["string", "null"], "pattern": "^[0-9]{2,6}$" }
      }
    },
    "reportingPeriod": {
      "type": "object",
      "required": ["fiscalYearStart", "fiscalYearEnd", "emissionsCalendarYear", "submissionDeadline", "isFirstYearFiling"],
      "additionalProperties": false,
      "properties": {
        "fiscalYearStart": { "type": "string", "format": "date" },
        "fiscalYearEnd": { "type": "string", "format": "date" },
        "emissionsCalendarYear": { "type": "integer", "minimum": 2020, "maximum": 2035 },
        "submissionDeadline": { "type": "string", "format": "date", "const": "2026-11-10" },
        "isFirstYearFiling": { "type": "boolean" }
      }
    },
    "organizationalBoundary": {
      "type": "object",
      "required": ["method", "appliedConsistently"],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "enum": ["operational_control", "financial_control", "equity_share"]
        },
        "appliedConsistently": { "type": "boolean" },
        "equitySharePercentage": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "notes": { "type": ["string", "null"] }
      }
    },
    "scope1": {
      "type": "object",
      "required": ["totalTCO2e", "sources", "biogenicCO2Separate"],
      "additionalProperties": false,
      "properties": {
        "totalTCO2e": { "type": "number", "minimum": 0 },
        "biogenicCO2Separate": { "type": "number", "minimum": 0 },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["category", "activityData", "activityUnit", "emissionFactor", "emissionFactorSource", "gwpApplied", "tCO2e"],
            "additionalProperties": false,
            "properties": {
              "category": {
                "type": "string",
                "enum": ["stationary_combustion", "mobile_combustion", "process_emissions", "fugitive_emissions"]
              },
              "description": { "type": ["string", "null"] },
              "activityData": { "type": "number", "minimum": 0 },
              "activityUnit": { "type": "string" },
              "emissionFactor": { "type": "number" },
              "emissionFactorUnit": { "type": ["string", "null"] },
              "emissionFactorSource": { "type": "string" },
              "gwpApplied": { "type": "string" },
              "tCO2e": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "scope2": {
      "type": "object",
      "required": ["locationBasedTotalTCO2e", "marketBasedTotalTCO2e"],
      "additionalProperties": false,
      "properties": {
        "locationBasedTotalTCO2e": { "type": "number", "minimum": 0 },
        "marketBasedTotalTCO2e": { "type": "number", "minimum": 0 },
        "notes": { "type": ["string", "null"] }
      }
    },
    "scope3": {
      "type": "object",
      "description": "Value-chain emissions. Not required for 2026. Structured for 2027+ phase-in. Note: as of 2026-11-09 Ninth Circuit ruling, Scope 3 mandate is subject to preliminary injunction.",
      "additionalProperties": false,
      "properties": {
        "isRequiredForThisFiling": { "type": "boolean", "default": false },
        "totalTCO2e": { "type": ["number", "null"], "minimum": 0 },
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["categoryNumber", "categoryName", "status"],
            "additionalProperties": false,
            "properties": {
              "categoryNumber": { "type": "integer", "minimum": 1, "maximum": 15 },
              "categoryName": { "type": "string" },
              "status": {
                "type": "string",
                "enum": ["required", "voluntary", "excluded", "not_applicable"]
              },
              "tCO2e": { "type": ["number", "null"], "minimum": 0 },
              "exclusionRationale": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "methodology": {
      "type": "object",
      "required": ["ghgProtocolConformance", "gwpSet", "emissionFactorDatabases"],
      "additionalProperties": false,
      "properties": {
        "ghgProtocolConformance": { "type": "boolean", "const": true },
        "gwpSet": { "type": "string" },
        "emissionFactorDatabases": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "assumptionsAndEstimates": { "type": ["string", "null"] }
      }
    },
    "assurance": {
      "type": "object",
      "required": ["levelForThisFiling"],
      "additionalProperties": false,
      "properties": {
        "levelForThisFiling": {
          "type": "string",
          "enum": ["none", "limited", "reasonable"]
        },
        "provider": {
          "type": ["object", "null"],
          "properties": {
            "name": { "type": "string" },
            "email": { "type": ["string", "null"], "format": "email" }
          }
        },
        "standardUsed": {
          "type": ["string", "null"],
          "enum": ["AA1000AS_v3", "AICPA_AT-C_210", "ISAE_3000_with_3410", "ISSA_5000", "ISO_14064-3", "other", null]
        },
        "explanationIfNoAssurance": { "type": ["string", "null"] }
      }
    },
    "firstYearRelief": {
      "type": "object",
      "required": ["wasCollectingDataAsOf2024_12_05", "statementOfNonReporting"],
      "additionalProperties": false,
      "properties": {
        "wasCollectingDataAsOf2024_12_05": { "type": "boolean" },
        "statementOfNonReporting": { "type": "boolean" },
        "nonReportingExplanation": { "type": ["string", "null"] }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "inputDataHash",
        "canonicalByteStreamHash",
        "functionVersion",
        "merkleRoot",
        "ed25519Signature",
        "hashBasedSignature",
        "timestampUtc"
      ],
      "additionalProperties": false,
      "properties": {
        "inputDataHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "canonicalByteStreamHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "functionVersion": { "type": "string" },
        "merkleRoot": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "ed25519Signature": { "type": "string" },
        "ed25519PublicKey": { "type": ["string", "null"] },
        "hashBasedSignature": { "type": "string" },
        "timestampUtc": { "type": "string", "format": "date-time" }
      }
    },
    "enforcementAwareness": {
      "type": "object",
      "required": ["maxCivilPenaltyPerYear", "feeNoticeApproximateDate", "feePaymentWindowDays"],
      "additionalProperties": false,
      "properties": {
        "maxCivilPenaltyPerYear": { "type": "integer", "const": 500000 },
        "feeNoticeApproximateDate": { "type": "string", "format": "date" },
        "feePaymentWindowDays": { "type": "integer", "const": 60 },
        "ninthCircuitNote": { "type": "string" }
      }
    }
  }
}
